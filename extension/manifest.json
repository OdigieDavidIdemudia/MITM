{
  "manifest_version": 3,
  "name": "MITM - Proxy Shield",
  "version": "2.0",
  "author": "Odigie David Idemudia",
  "description": "Companion extension for your custom proxy. Tab-level execution and telemetry. Built by Odigie David Idemudia.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://192.168.252.10/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
